# Bit-width -> GLWE parameter table (Section 5.2, Table `tab:exchange`; Appendix Table `tab:glwe-params`).
#
# For each quantization bit-width b, Round 1 needs p = 2 N B^2 with N = 1024, B = 2^(b-1), and decrypts
# correctly except with probability 2^-64 per coefficient whenever  q / sigma >= 2 r sqrt(N) B p  (r = 9.16),
# i.e.  log2 sigma_max(b) = 64 - log2(2r) - 5 - (b-1) - (2b+9) = 46.8 - 3b  for q = 2^64 - 2^32 + 1.
# Security is evaluated with the lattice estimator at sigma = sigma_max(b) for LWE dimension n = kappa*d,
# ternary secret, for LWE dimension 2^10 and 2^11 (d=2^10 with kappa=2, or d=2^11 with kappa=1). The smallest
# dimension reaching 128 bits is selected; the paper instantiates it as d=2^11, kappa=1.
#
# Round 2 encrypts a one-hot vector over m chunks with B = p = 2^24, so its correctness ceiling is
# log2 sigma_max(m) = 64 - log2(2r) - log2(m)/2 - 48, i.e. 2^5.3 at m = 2^13 and 2^1.8 at m = 2^20. It uses the
# fixed width sigma = 3.2 (2^1.7), correct up to m = 2^20 chunks, which is also the `d12` feature of the vpir
# crate. Security is evaluated at LWE dimension 2^11 and 2^12; 2^12 is the smallest reaching 128 bits.
#
# Run:  sage analysis/glwe_params.sage [--estimator PATH] [--out results/glwe_params.json]
# Prints the LaTeX rows for the two tables. Takes ~20 min (16 full estimator calls); results are cached in
# the JSON, pass --cached to only re-emit LaTeX from it, or --round2-only to recompute only the Round-2
# entries (a few minutes) and keep the Round-1 ones.
import sys, math, json, argparse, os
ap = argparse.ArgumentParser()
ap.add_argument("--estimator", default=os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lattice-estimator"),
                help="checkout of https://github.com/malb/lattice-estimator")
ap.add_argument("--out", default=os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "results", "glwe_params.json"))
ap.add_argument("--cached", action="store_true")
ap.add_argument("--round2-only", action="store_true", help="recompute only the Round-2 entries of the JSON")
ap.add_argument("--target", type=int, default=128)
args = ap.parse_args()

Q64 = 2**64 - 2**32 + 1
R = float(9.16)     # 2^-64 per-coefficient failure (Sage preparser: keep as Python float for JSON)
N = 1024            # embedding dimension = Round-1 inner dimension
LOG_D = 10
DENY = ("arora-gb", "bkw", "bdd_mitm_hybrid", "dual_mitm_hybrid")
R2_SIGMA = float(3.2)   # Round-2 noise width (2^1.7), see header

def log2_sigma_max(b):
    return float(64 - math.log2(2*R) - 0.5*math.log2(N) - (b-1) - (2*b+9))

if not args.cached:
    sys.path.insert(0, args.estimator)
    from estimator import LWE, ND
    Xs = ND.UniformMod(3)
    def lam(n, ls):
        P = LWE.Parameters(n=n, q=Q64, Xs=Xs, Xe=ND.DiscreteGaussian(2**ls))
        res = LWE.estimate(P, quiet=True, deny_list=DENY)
        k, v = min(res.items(), key=lambda kv: kv[1]["rop"])
        return float(math.log2(v["rop"])), k
    out = json.load(open(args.out)) if args.round2_only else {}
    for b in ([] if args.round2_only else range(2, 9)):
        ls = log2_sigma_max(b)
        row = {"b": b, "log2_p": 2*b+9, "log2_sigma_max": ls}
        for kappa in (1, 2):
            l, k = lam(kappa * 2**LOG_D, ls)
            row[f"lambda_k{kappa}"] = l; row[f"attack_k{kappa}"] = k
            print(f"b={b} log2sigma={ls:.2f} kappa={kappa}: lambda={l:.1f} ({k})", file=sys.stderr, flush=True)
        out[str(b)] = row
    # Round 2: one-hot query over m, B = p = 2^24, sigma = 3.2 (correct up to m = 2^20, see header)
    ls2 = math.log2(R2_SIGMA)
    for log_d in (11, 12):
        l, k = lam(2**log_d, ls2)
        out[f"round2_d{log_d}"] = {"sigma": R2_SIGMA, "log2_sigma": ls2, "lambda": l, "attack": k}
        print(f"round2 d=2^{log_d} sigma={R2_SIGMA}: lambda={l:.1f} ({k})", file=sys.stderr, flush=True)
    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    json.dump(out, open(args.out, "w"), indent=1)
out = json.load(open(args.out))

print("% tab:exchange cryptographic side, generated by analysis/glwe_params.sage")
for b in range(2, 9):
    r = out[str(b)]
    log_d = 10 if r["lambda_k1"] >= args.target else 11   # (d=2^10,k=2) and (d=2^11,k=1) share the LWE dimension; we instantiate d=2^11
    l1, l2 = r["lambda_k1"], r["lambda_k2"]
    print(f"${b}$ & $2^{{{r['log2_p']}}}$ & $2^{{{r['log2_sigma_max']:.1f}}}$ & ${l1:.0f}$ & ${l2:.0f}$ & $2^{{{log_d}}}$ \\\\")
print("% Round 2 candidates:", {k: round(v["lambda"], 1) for k, v in out.items() if k.startswith("round2")})
r2 = out["round2_d12"]
print("% tab:glwe-params Round-2 row, generated by analysis/glwe_params.sage")
print(f"Round 2 & $2^{{12}}$ & $1$ & $2^{{64}} - 2^{{32}} + 1$ & $2^{{24}}$ & $2^{{{r2['log2_sigma']:.1f}}}$ & ${r2['lambda']:.0f}$ & $2^{{-64}}$ \\\\")
